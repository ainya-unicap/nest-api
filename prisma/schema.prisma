generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model AcademicPeriod {
    id        String   @id @default(uuid())
    name String
    semester String //Emun PRIMEIRO SEGUNDO
    start_date DateTime
    end_date DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    turmas    Turma[]
}

    
model AlunoTurma {
    user_id   String
    user      User     @relation(fields: [user_id], references: [id])
    turma_id  String
    turma     Turma    @relation(fields: [turma_id], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@id([user_id, turma_id]) // chave primária composta — impede vínculo duplicado
    @@index([turma_id])
}

    
model Canteiro {
    id        String           @id @default(uuid())
    plant_id  String
    plant     PlantaForrageira @relation(fields: [plant_id], references: [id])
    name     String
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    listaDeFormularios ListaDeFormularios[]
    relatorios         Relatorio[]
    users              UserCanteiro[]

    @@index([plant_id])
}


// Formulário de manejo semanal. Campos fixos, iguais para qualquer planta —
// substituiu o modelo antigo (altura/estádio/checklist configuráveis por
// espécie via PlantTemplate, que foi removido junto com Checklist e
// Measurement).
model Formulario {
    id            String             @id @default(uuid())
    list_id       String
    list          ListaDeFormularios @relation(fields: [list_id], references: [id])
    user_id       String
    user          User               @relation(fields: [user_id], references: [id])
    type          String             //Enum SEMANAL DIARIO
    title         String             // título do formulário
    date          DateTime           // data do registro (substitui started_at/ended_at)
    week          Int?               // semana do acompanhamento (1 a 12), escolhida pelo aluno
    weather       String             //Enum SOL NUBLADO CHUVA
    estimated_height_cm Float        // altura estimada da planta, em cm
    phenological_stage  String       //Enum VEGETATIVO ELONGACAO FLORESCIMENTO

    // Checklist fixo (5 itens, iguais para qualquer planta)
    checklist_irrigacao Boolean @default(false) // irrigação verificada
    checklist_capina    Boolean @default(false) // capina realizada
    checklist_adubacao  Boolean @default(false) // adubação de cobertura
    checklist_plantio   Boolean @default(false) // plantio/replantio
    checklist_pragas    Boolean @default(false) // controle de pragas

    observations  String
    synced        Boolean @default(false)
    createdAt     DateTime           @default(now())
    updatedAt     DateTime           @updatedAt

    // Registro fotográfico — limite de 5 fotos por formulário, aplicado no service.
    photos       Photo[]

    @@index([list_id])
    @@index([user_id])
}

    
model Institution {
    id        String   @id @default(uuid())
    name      String
    users     User[]
    turmas    Turma[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

    
model ListaDeFormularios {
    id          String   @id @default(uuid())
    canteiro_id String 
    canteiro    Canteiro @relation(fields: [canteiro_id], references: [id])
    plant_id    String
    plant       PlantaForrageira @relation(fields: [plant_id], references: [id])
    created_by  String
    user        User             @relation(fields: [created_by], references: [id])
    name        String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    formularios Formulario[]
    relatorios  Relatorio[]
    resumosIA   ResumoIA[]

    @@index([canteiro_id])
    @@index([plant_id])
    @@index([created_by])
}


model Photo {
    id        String   @id @default(uuid())
    form_id   String
    form      Formulario    @relation(fields: [form_id], references: [id])
    url       String
    takenAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([form_id])
}

    
model PlantaForrageira {
    id             String   @id @default(uuid())
    name          String
    category      String //Enum GRAMINEA, LEGUMINOSA, CACTACEA, OUTRO
    description    String
    semester_focus String //Enum PRIMEIRO, SEGUNDO, AMBOS
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    canteiros          Canteiro[]
    listaDeFormularios ListaDeFormularios[]
}

    model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}
model Relatorio {
    id        String   @id @default(uuid())
    user_id   String
    user      User             @relation(fields: [user_id], references: [id])
    canteiro_id String 
    canteiro    Canteiro @relation(fields: [canteiro_id], references: [id])
    list_id      String
    list         ListaDeFormularios @relation(fields: [list_id], references: [id])
    status String //Enum RASCUNHO, SUBMETIDO, CORRIGIDO
    introduction String
    objective String
    development String
    final_thoughts String
    references String
    grade Float
    feedback String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    submittedAt DateTime

    @@index([user_id])
    @@index([list_id])
    @@index([canteiro_id])
}

    
model Turma {
    id        String   @id @default(uuid())
    institution_id String?
    institution Institution? @relation(fields: [institution_id], references: [id])
    period_id String
    period AcademicPeriod @relation(fields: [period_id], references:[id])
    name String
    created_by String
    user      User             @relation(fields: [created_by], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    alunoTurmas AlunoTurma[]

    @@index([institution_id])
    @@index([period_id])
    @@index([created_by])
}

    
model User {
    id             String   @id @default(uuid())
    name           String
    email          String   @unique
    password       String
    role           String   @default("aluno") //enum "aluno", "professor", "admin"
    institution_id String?
    institution Institution? @relation(fields: [institution_id], references: [id])
    matricula      String?
    avatarUrl      String?
    refreshTokens      RefreshToken[]
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    alunoTurmas        AlunoTurma[]
    canteiros          UserCanteiro[]
    formularios        Formulario[]
    listasFormularios  ListaDeFormularios[]
    relatorios         Relatorio[]
    turmasCriadas      Turma[]
    resumosIA          ResumoIA[]
    passwordResetCodes PasswordResetCode[]

    @@index([institution_id])
    // NULL não colide com NULL no Postgres: o índice só "trava" quando os
    // dois campos estão preenchidos, exatamente o comportamento pedido.
    @@unique([institution_id, matricula])
}

model PasswordResetCode {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    codeHash  String
    expiresAt DateTime
    attempts  Int      @default(0)

    usedAt     DateTime?
    verifiedAt DateTime?

    resetTokenHash      String?
    resetTokenExpiresAt DateTime?

    createdAt DateTime @default(now())

    @@index([userId])
}

model UserCanteiro {
  user_id     String
  canteiro_id String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id])
  canteiro Canteiro @relation(fields: [canteiro_id], references: [id])

  @@id([user_id, canteiro_id]) // chave primária composta
  @@index([canteiro_id])
}

// Resumo gerado pela IA a partir dos formulários de uma lista.
// Fluxo assíncrono: o POST cria como PENDENTE e o front consulta até PRONTO/ERRO.
model ResumoIA {
    id            String             @id @default(uuid())
    list_id       String
    list          ListaDeFormularios @relation(fields: [list_id], references: [id], onDelete: Cascade)
    user_id       String
    user          User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
    status        String             @default("PENDENTE") //Enum PENDENTE, PROCESSANDO, PRONTO, ERRO
    secoes        Json?              // { introducao, desenvolvimento, cuidados, conclusao }
    dossie        Json?              // entrada exata enviada ao modelo (auditoria)
    modelo        String?
    prompt_versao String?
    tokens_entrada Int?
    tokens_saida   Int?
    duracao_ms     Int?
    erro          String?
    createdAt     DateTime           @default(now())
    updatedAt     DateTime           @updatedAt
    concluidoEm   DateTime?

    @@index([list_id])
    @@index([user_id])
    @@index([status])
}
