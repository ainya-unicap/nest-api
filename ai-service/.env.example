# Provedor de LLM usado por padrão: groq | gemini
# O Nest pode forçar outro mandando "provedor" no corpo do /resumir.
LLM_PROVIDER=groq

# Segredo compartilhado com o Nest (AI_INTERNAL_TOKEN no .env da API).
# Vazio = serviço aberto; aceitável só em desenvolvimento local.
INTERNAL_TOKEN=

# ---- Groq — https://console.groq.com/keys ----
GROQ_API_KEY=
# GET /modelos?provedor=groq lista os ids que a sua chave enxerga.
GROQ_MODEL=openai/gpt-oss-120b
# Temperatura baixa porque é texto técnico factual.
GROQ_TEMPERATURE=0.3
# O gpt-oss raciocina antes de responder, e isso consome este limite.
# Plano gratuito: 8000 tokens/minuto contando a entrada (~3700) + este teto; acima de ~4300 dá 413.
GROQ_MAX_TOKENS=4000
# Quanto o modelo raciocina: low | medium | high. Mais = mais lento e mais tokens.
GROQ_REASONING_EFFORT=low

# ---- Gemini — https://aistudio.google.com/apikey ----
GEMINI_API_KEY=
# GET /modelos?provedor=gemini lista os ids que a sua chave enxerga.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
# Nos modelos 2.5 o raciocínio interno consome este limite.
GEMINI_MAX_TOKENS=8192
