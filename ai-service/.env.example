# Chave da Groq — https://console.groq.com/keys
# É a ÚNICA variável obrigatória para o serviço funcionar.
GROQ_API_KEY=

# Modelo usado. GET /modelos lista os ids que a sua chave enxerga.
GROQ_MODEL=llama-3.3-70b-versatile

# Segredo compartilhado com o Nest (AI_INTERNAL_TOKEN no .env da API).
# Vazio = serviço aberto; aceitável só em desenvolvimento local.
INTERNAL_TOKEN=

# Ajustes do modelo. Temperatura baixa porque é texto técnico factual.
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2000
