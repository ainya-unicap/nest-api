# Conexão Postgres (Neon ou local via docker-compose)
DATABASE_URL=

# Segredo para assinar JWTs (qualquer string longa).
# Obrigatório: a aplicação não sobe sem ele.
JWT_SECRET=

# development | production
NODE_ENV=development

# Token do Vercel Blob (necessário só em produção, gerado no painel da Vercel
# em Storage → Blob → .env.local). Em dev, sem token, o upload usa disco local.
BLOB_READ_WRITE_TOKEN=

# ---- Integração com o ai-service (resumo por IA) ----
# URL do serviço Python. Em dev: uvicorn main:app --port 8000 dentro de ai-service/
AI_SERVICE_URL=http://localhost:8000

# Segredo compartilhado; precisa ser igual ao INTERNAL_TOKEN do ai-service/.env.
# Vazio nos dois lados = sem autenticação entre os serviços (só em dev).
AI_INTERNAL_TOKEN=

# Quanto o Nest espera o ai-service responder (a Groq costuma levar 5-30s).
AI_TIMEOUT_MS=120000
